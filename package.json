{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src backend/src functions",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "concurrently -k npm:dev:frontend npm:dev:backend",
    "test:e2e": "playwright test",
    "test:game": "tsx --test tests/runner.test.ts",
    "test:cloudflare": "tsx --test tests/cloudflare.test.ts tests/traffic.test.ts",
    "preview:cloudflare": "wrangler pages dev dist",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name mln111"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.2.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "wrangler": "^4.137.0"
  }
}
